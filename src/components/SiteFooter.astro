---
import { navOf, t } from '../i18n/ui';

type Props = { locale: string };
const { locale } = Astro.props;
const nav = navOf(locale);
const ui = t(locale);
const links = [
  ...(nav.about ? [{ href: nav.about, label: 'About' }] : []),
  ...(nav.contact ? [{ href: nav.contact, label: 'Contact' }] : []),
  ...(nav.legal ? [{ href: nav.legal, label: 'Legal' }] : []),
  { href: nav.feed, label: ui.rss },
];
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div>
      <a href={nav.home} class="logo logo--light"><span>hopone</span></a>
      <p>{ui.footerTagline}</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="wrap footer__legal">© {new Date().getFullYear()} Hopone. All rights reserved. {ui.footerLegal}</div>
</footer>
