---
import type { Card } from '@publisher/astro';
import { Picture } from '@publisher/astro/components';
import { formatDate, t } from '../i18n/ui';

interface Props {
  card: Card;
  locale: string;
  size?: 'lead' | 'side' | 'grid';
  headingLevel?: 'h2' | 'h3';
}

const { card, locale, size = 'grid', headingLevel: H = 'h3' } = Astro.props;
const sizes = { lead: '(max-width: 900px) 100vw, 60vw', side: '120px', grid: '(max-width: 700px) 100vw, 380px' }[size];

// Stable colour per content, for cards without an image.
const TONES = ['lime', 'orange', 'blue', 'ink'] as const;
const tone = TONES[[...card.path].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 0) % TONES.length];
---

<article class={`card card--${size}`}>
  <a href={card.path} class={`card__visual tone-${tone}`} aria-hidden="true" tabindex="-1">
    {
      card.image ? (
        <Picture image={{ ...card.image, alt: '' }} class="card__img" sizes={sizes} loading={size === 'lead' ? 'eager' : 'lazy'} />
      ) : (
        <span class="card__track" />
      )
    }
  </a>
  <div class="card__body">
    <p class="card__kicker">{card.category.name}</p>
    <H class="card__title"><a href={card.path}>{card.title}</a></H>
    {size !== 'side' && <p class="card__excerpt">{card.description}</p>}
    <p class="card__meta">
      {card.author && <span>{card.author.name}</span>}
      {card.author && <span aria-hidden="true">·</span>}
      <time datetime={card.publishedAt}>{formatDate(locale, card.publishedAt)}</time>
      <span aria-hidden="true">·</span>
      <span>{card.readingMinutes} {t(locale).minRead}</span>
    </p>
  </div>
</article>
