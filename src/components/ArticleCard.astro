---
import CmsPicture from '@autoedit/astro-cms/components/CmsPicture.astro';
import { type Article, formatDate } from '../data/articles';

interface Props {
  article: Article;
  size?: 'lead' | 'side' | 'grid';
  headingLevel?: 'h2' | 'h3';
}

const { article, size = 'grid', headingLevel: H = 'h3' } = Astro.props;
const { href } = article;
const sizes = { lead: '(max-width: 900px) 100vw, 60vw', side: '120px', grid: '(max-width: 700px) 100vw, 380px' }[size];
---

<article class={`card card--${size}`}>
  <a href={href} class={`card__visual tone-${article.tone}`} aria-hidden="true" tabindex="-1">
    {
      article.cover ? (
        <CmsPicture image={{ ...article.cover, alt: '' }} class="card__img" sizes={sizes} priority={size === 'lead'} />
      ) : (
        <span class="card__track" />
      )
    }
  </a>
  <div class="card__body">
    <p class="card__kicker">{article.category}</p>
    <H class="card__title"><a href={href}>{article.title}</a></H>
    {size !== 'side' && <p class="card__excerpt">{article.excerpt}</p>}
    <p class="card__meta">
      <span>{article.author}</span>
      <span aria-hidden="true">·</span>
      <time datetime={article.date}>{formatDate(article.date)}</time>
      <span aria-hidden="true">·</span>
      <span>{article.readingTime} min read</span>
    </p>
  </div>
</article>
