---
import type { List } from '@publisher/astro';
import ArticleCard from './ArticleCard.astro';
import { t } from '../i18n/ui';

interface Props {
  locale: string;
  heading: string;
  description?: string;
  list: List;
}

const { locale, heading, description, list } = Astro.props;
const ui = t(locale);
---

<main id="main" class="wrap listing">
  <div class="section-head">
    <h1 class="section-title">{heading}</h1>
    {description && <p class="listing__desc">{description}</p>}
  </div>
  {
    list.items.length > 0 ? (
      <div class="grid">
        {list.items.map((card) => (
          <ArticleCard card={card} locale={locale} />
        ))}
      </div>
    ) : (
      <p class="listing__empty">{ui.empty}</p>
    )
  }
  {
    list.pageCount > 1 && (
      <nav class="pagination" aria-label="Pagination">
        {list.prev ? <a href={list.prev} rel="prev">{ui.newer}</a> : <span />}
        <span class="pagination__status">{ui.pageOf(list.page, list.pageCount)}</span>
        {list.next ? <a href={list.next} rel="next">{ui.older}</a> : <span />}
      </nav>
    )
  }
</main>
