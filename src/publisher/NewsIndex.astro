---
import type { TemplateProps } from '@publisher/astro';
import Listing from '../components/Listing.astro';
import { t } from '../i18n/ui';

type Props = TemplateProps<'NewsIndex'>;
const { locale, list } = Astro.props;
const ui = t(locale);
---

<Listing locale={locale} heading={ui.newsIndexHeading} description={ui.newsIndexIntro} list={list} />
