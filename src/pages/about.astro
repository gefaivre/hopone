---
// The about page: a coded page, declared in publisher.config.ts. Its text lives here.
import Layout from '../publisher/Layout.astro';
import { PublisherHead } from '@publisher/astro/components';
import { codedPage } from '@publisher/astro/site';
import { navOf } from '../i18n/ui';

export const prerender = true;
const page = codedPage(Astro.url.pathname);
const nav = navOf(page.locale);
---

<Layout locale={page.locale} alternates={page.alternates}>
  <PublisherHead slot="head" />
  <main id="main" class="wrap article">
    <header class="article__head">
      <p class="card__kicker">About</p>
      <h1>The business and finance of running</h1>
      <p class="article__dek">
        Hopone covers the money behind running: brand earnings, race economics, sponsorship, startups and retail.
      </p>
    </header>
    <div class="article__body">
      <p>
        Running is a business worth tens of billions of dollars. Shoe brands report their results every quarter, marathons
        sell their entry fees by ballot, sponsors pay to put their name on a race, and investors fund the apps and
        watches that runners use. Hopone follows that money.
      </p>
      <p>
        Every story answers one question: who makes or loses money, how much, and why. We lead with the key figure, give
        its source, and explain what it means for brands, races and runners. Hopone is written for curious runners,
        industry insiders and investors.
      </p>
      <h2>How Hopone is made</h2>
      <p>
        Hopone articles are written with AI by the Hopone Newsroom, from published sources only: company reports, press
        releases, official statements and the reporting of other news outlets. Every source is credited and linked in
        the article. Figures we compute ourselves are marked “Hopone calculation”.
      </p>
      <p>Hopone takes no position on politics and gives no investment advice.</p>
      <h2>Sections</h2>
      <ul>
        {nav.categories.map((c) => <li><a href={c.path}>{c.name}</a></li>)}
      </ul>
      <p>Hopone is published by Publiseo. Every Monday, our free newsletter sums up the business of running.</p>
      <p><a href={`${nav.home === '/' ? '' : nav.home}/#newsletter`}>Subscribe to the newsletter →</a></p>
    </div>
  </main>
</Layout>
