---
// The contact page: a coded page, declared in publisher.config.ts. Its text lives here.
import Layout from '../publisher/Layout.astro';
import { PublisherHead } from '@publisher/astro/components';
import { codedPage } from '@publisher/astro/site';

export const prerender = true;
const page = codedPage(Astro.url.pathname);
---

<Layout locale={page.locale} alternates={page.alternates}>
  <PublisherHead slot="head" />
  <main id="main" class="wrap article">
    <header class="article__head">
      <p class="card__kicker">Contact</p>
      <h1>Contact Hopone</h1>
      <p class="article__dek">A correction, a figure we got wrong, a story we should look at: write to us.</p>
    </header>
    <div class="article__body">
      <p>Email: <a href="mailto:contact@hopone.run">contact@hopone.run</a></p>
      <p>
        If you report an error, include the link to the article and, if you can, the source that shows the right
        figure. Hopone gives no investment advice and does not answer questions about stocks.
      </p>
    </div>
  </main>
</Layout>
