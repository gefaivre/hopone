---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getArticles, categories, categorySlug, briefs } from '../data/articles';

const title = 'Hopone — The business and finance of running';
const description =
  'Hopone covers the economics of running: markets, brands, marathons, sponsorship, startups and retail. Running business news, every day.';

const site = Astro.site!.toString().replace(/\/$/, '');
const allArticles = await getArticles(13);
const [lead, ...rest] = allArticles;
const topStories = rest.slice(0, 3);
const latest = rest.slice(3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsMediaOrganization',
    name: 'Hopone',
    url: site,
    logo: `${site}/favicon.svg`,
    description,
    sameAs: [],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Hopone',
    url: site,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: allArticles.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${site}${a.href}`,
      name: a.title,
    })),
  },
];

const stats = [
  { value: '$11.2bn', label: 'Nike revenue in Q1 fiscal 2027, down 4%', slug: 'nike-q1-fiscal-2027-pace-plan' },
  { value: '166,000', label: 'Applicants for the first Paris Marathon ballot', slug: 'paris-marathon-2027-lottery' },
  { value: '€130', label: 'Dublin Marathon entry fee for 2027, up 18%', slug: 'dublin-marathon-entry-fee-2027' },
  { value: '4.2×', label: 'Applicants per place at the Copenhagen Half', slug: 'copenhagen-half-marathon-2027-lottery' },
];

---

<Base title={title} description={description} jsonLd={jsonLd}>
  <SiteHeader />

  <div class="ticker" role="region" aria-label="Briefing">
    <span class="ticker__label">Briefing</span>
    <div class="ticker__viewport">
      <ul class="ticker__track">
        {[...briefs, ...briefs].map((b, i) => <li aria-hidden={i >= briefs.length ? 'true' : undefined}>{b}</li>)}
      </ul>
    </div>
  </div>

  <main id="main">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero__intro">
        <p class="eyebrow">The business of running</p>
        <h1 id="hero-title">
          Follow the money<br />that keeps the world <em>running</em>.
        </h1>
        <p class="hero__lead">
          Brands, marathons, sponsorship, startups: every day, Hopone breaks down the economics of running for
          curious runners, industry insiders and investors.
        </p>
      </div>

      <div class="hero__grid">
        <ArticleCard article={lead} size="lead" headingLevel="h2" />
        <div class="hero__side">
          <h2 class="section-label">Top stories</h2>
          {topStories.map((a) => <ArticleCard article={a} size="side" />)}
        </div>
      </div>
    </section>

    <section class="stats" aria-labelledby="stats-title">
      <div class="wrap">
        <h2 id="stats-title" class="section-title section-title--light">Running by the numbers</h2>
        <ul class="stats__grid">
          {
            stats.map((s) => (
              <li>
                <strong>{s.value}</strong>
                <span>{s.label}</span>
                <a href={`/articles/${s.slug}`} class="stats__link">Read the story →</a>
              </li>
            ))
          }
        </ul>
        <p class="stats__note">Every figure comes from a sourced Hopone article.</p>
      </div>
    </section>

    <section class="wrap latest" aria-labelledby="latest-title">
      <div class="section-head">
        <h2 id="latest-title" class="section-title">Latest analysis</h2>
        <a href="/articles" class="link-arrow">All analysis →</a>
      </div>
      <div class="grid">
        {latest.map((a) => <ArticleCard article={a} />)}
      </div>
    </section>

    <section class="wrap rubriques" aria-labelledby="rub-title">
      <h2 id="rub-title" class="section-title">Our sections</h2>
      <ul class="rubriques__grid">
        {
          categories.map((c, i) => (
            <li>
              <a href={`/section/${categorySlug(c.name)}`}>
                <span class="rubriques__num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{c.name}</h3>
                <p>{c.desc}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="newsletter" aria-labelledby="nl-title">
      <div class="wrap newsletter__inner">
        <div>
          <p class="eyebrow eyebrow--dark">Every Monday, 7am</p>
          <h2 id="nl-title">The newsletter that sums up the business of running.</h2>
          <p>A 5-minute read. The week’s deals, numbers and trends. Free.</p>
        </div>
        <form
          id="newsletter"
          class="newsletter__form"
          action="https://cardinal-seven.vercel.app/api/subscribe"
          method="POST"
        >
          <input type="hidden" name="site" value="hopone" />
          <input type="hidden" name="lang" value="fr" />
          <!-- Anti-spam : champ invisible, à laisser vide -->
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            style="position:absolute;left:-9999px"
            aria-hidden="true"
          />
          <div class="newsletter__input-wrap">
            <label for="newsletter-email" class="sr-only">Email address</label>
            <input
              id="newsletter-email"
              type="email"
              name="email"
              required
              placeholder="ton@email.com"
              autocomplete="email"
            />
            <button type="submit" class="btn btn--dark">S'inscrire</button>
          </div>
          <p data-message class="newsletter__message" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<script>
  const form = document.getElementById("newsletter") as HTMLFormElement | null;
  if (form) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const message = form.querySelector("[data-message]") as HTMLElement | null;
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const data = Object.fromEntries(new FormData(form));

      if (submitBtn) {
        submitBtn.disabled = true;
      }
      if (message) {
        message.className = "newsletter__message";
        message.textContent = "";
      }

      try {
        const res = await fetch("https://cardinal-seven.vercel.app/api/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          // La langue de la page (<html lang="…">) détermine celle des emails
          body: JSON.stringify({ ...data, site: "hopone", lang: document.documentElement.lang || "fr" }),
        });
        const json = await res.json().catch(() => ({}));
        if (message) {
          message.textContent = json.message ?? (res.ok ? "Merci pour votre inscription !" : "Une erreur est survenue.");
          message.classList.add(res.ok ? "is-success" : "is-error");
        }
        if (res.ok) {
          form.reset();
          const emailVal = typeof data.email === "string" ? data.email : "";
          setTimeout(() => {
            window.location.href = `/newsletter/thank-you?email=${encodeURIComponent(emailVal)}`;
          }, 700);
        } else if (submitBtn) {
          submitBtn.disabled = false;
        }
      } catch (err) {
        if (message) {
          message.textContent = "Une erreur est survenue. Veuillez réessayer.";
          message.classList.add("is-error");
        }
        if (submitBtn) {
          submitBtn.disabled = false;
        }
      }
    });
  }
</script>
