---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles, toArticle, formatDate, categorySlug, AUTHOR } from '../../data/articles';

export async function getStaticPaths() {
  const entries = await getArticles();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, related: entries.filter((e) => e.id !== entry.id).slice(0, 3) },
  }));
}

const { entry, related } = Astro.props;
const { Content } = await render(entry);
const article = toArticle(entry);
const site = Astro.site!.toString().replace(/\/$/, '');
const url = `${site}/articles/${entry.id}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: entry.data.title,
    description: entry.data.excerpt,
    datePublished: entry.data.date.toISOString(),
    dateModified: entry.data.date.toISOString(),
    articleSection: entry.data.category,
    inLanguage: 'en',
    mainEntityOfPage: url,
    author: { '@type': 'Organization', name: AUTHOR, url: site },
    publisher: { '@type': 'NewsMediaOrganization', name: 'Hopone', url: site, logo: `${site}/favicon.svg` },
    citation: entry.data.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      { '@type': 'ListItem', position: 2, name: entry.data.category, item: `${site}/section/${categorySlug(entry.data.category)}` },
      { '@type': 'ListItem', position: 3, name: entry.data.title, item: url },
    ],
  },
];
---

<Base title={`${entry.data.title} | Hopone`} description={entry.data.excerpt} type="article" jsonLd={jsonLd}>
  <SiteHeader />

  <main id="main" class="wrap article">
    <header class="article__head">
      <a class="card__kicker" href={`/section/${categorySlug(entry.data.category)}`}>{entry.data.category}</a>
      <h1>{entry.data.title}</h1>
      <p class="article__dek">{entry.data.excerpt}</p>
      <p class="card__meta">
        <span>{AUTHOR}</span>
        <span aria-hidden="true">·</span>
        <time datetime={article.date}>{formatDate(entry.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{article.readingTime} min read</span>
      </p>
    </header>

    <div class="article__body">
      <Content />
    </div>

    <aside class="article__sources" aria-labelledby="sources-title">
      <h2 id="sources-title">Sources</h2>
      <ol>
        {
          entry.data.sources.map((s) => (
            <li>
              <span class="article__source-name">{s.name}</span> —{' '}
              <a href={s.url} rel="noopener" target="_blank">{s.title}</a>
            </li>
          ))
        }
      </ol>
      <p class="article__disclosure">
        This article was written with AI by the Hopone Newsroom, using only the sources listed above. Figures marked
        “Hopone calculation” are our own arithmetic from those sources. Nothing here is investment advice.
      </p>
    </aside>

    {
      related.length > 0 && (
        <section class="article__related" aria-labelledby="related-title">
          <h2 id="related-title" class="section-title">More from Hopone</h2>
          <div class="grid">
            {related.map((e) => <ArticleCard article={toArticle(e)} />)}
          </div>
        </section>
      )
    }
  </main>

  <SiteFooter />
</Base>
