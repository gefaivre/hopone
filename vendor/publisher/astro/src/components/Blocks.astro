---
// The body of a content (docs/site-contract.md#blocks). Every block has a default rendering with
// `pub-` classes, styled by the site. A site may replace the rendering of a type:
// <Blocks blocks={content.blocks} components={{ callout: MyCallout }} /> — the component gets `block`.
import { inlineHtml, type Block, type BlockType } from "@publisher/client";
import Picture from "./Picture.astro";

type Props = {
  blocks: Block[];
  components?: Partial<Record<BlockType, (props: { block: any }) => any>>;
};
const { blocks, components = {} } = Astro.props;
---
{
  blocks.map((block) => {
    const Custom = components[block.type];
    if (Custom) return <Custom block={block} />;
    switch (block.type) {
      case "heading":
        return block.level === 2 ? <h2 class="pub-heading">{block.text}</h2> : <h3 class="pub-heading">{block.text}</h3>;
      case "paragraph":
        return <p class="pub-paragraph" set:html={inlineHtml(block.text)} />;
      case "list":
        return block.ordered ? (
          <ol class="pub-list">{block.items.map((item) => <li set:html={inlineHtml(item)} />)}</ol>
        ) : (
          <ul class="pub-list">{block.items.map((item) => <li set:html={inlineHtml(item)} />)}</ul>
        );
      case "image":
        return (
          <figure class="pub-image">
            <Picture image={block.image} sizes="(min-width: 768px) 768px, 100vw" />
            {block.caption && <figcaption>{block.caption}</figcaption>}
          </figure>
        );
      case "quote":
        return (
          <blockquote class="pub-quote">
            <p>{block.text}</p>
            {block.cite && <cite>{block.cite}</cite>}
          </blockquote>
        );
      case "callout":
        return (
          <aside class={`pub-callout pub-callout--${block.tone}`}>
            {block.title && <p class="pub-callout__title">{block.title}</p>}
            <p set:html={inlineHtml(block.text)} />
          </aside>
        );
      case "table":
        return (
          <div class="pub-table">
            <table>
              {block.caption && <caption>{block.caption}</caption>}
              <thead><tr>{block.header.map((h) => <th scope="col">{h}</th>)}</tr></thead>
              <tbody>{block.rows.map((row) => <tr>{row.map((cell) => <td set:html={inlineHtml(cell)} />)}</tr>)}</tbody>
            </table>
          </div>
        );
      case "faq":
        return (
          <div class="pub-faq">
            {block.items.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p set:html={inlineHtml(item.answer)} />
              </details>
            ))}
          </div>
        );
      case "keyTakeaways":
        return <ul class="pub-takeaways">{block.items.map((item) => <li set:html={inlineHtml(item)} />)}</ul>;
    }
  })
}
